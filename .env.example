# Copy to .env. Generate EACH secret separately: openssl rand -hex 32
POSTGRES_USER=lehub
POSTGRES_DB=lehub
POSTGRES_PASSWORD=
# Local development only; Compose builds its own database URL.
DATABASE_URL=postgresql://lehub:REPLACE_WITH_RANDOM_HEX@localhost:5432/lehub
BETTER_AUTH_URL=http://localhost:3000
# Caddy fourni : domaine public sans protocole ni chemin.
LEHUB_DOMAIN=lehub.example.com
# Proxy Docker déjà installé : réseau externe partagé.
PROXY_NETWORK=web
BETTER_AUTH_SECRET=
SETUP_KEY=
DOCUMENTS_DIR=/app/data/documents


# Rappels et récupération d’accès (SMTP avec TLS, sauf relais local explicite)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_ALLOW_PLAINTEXT=false
OCR_ENABLED=true
# Tests : URL d’un serveur de test ; le script crée puis supprime sa propre base.
TEST_POSTGRES_URL=

# Notifications navigateur : npm run push:keys ; renseigner un contact réel.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Profil Compose backups : clé indépendante, à conserver hors du serveur.
BACKUP_ENCRYPTION_KEY=
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=7
SERVER_BACKUPS_DIR=/app/data/backups
# Optionnel : PostgreSQL dédié aux restaurations de contrôle (CREATE DATABASE).
BACKUP_TEST_POSTGRES_URL=

# OCR : maximum 100 fichiers par cycle, 4 traitements simultanés.
OCR_BATCH_SIZE=10
OCR_CONCURRENCY=2
# Copie hors serveur après validation de l’archive chiffrée (rclone).
# Exemple : nas:lehub/backups ou s3:mon-bucket/lehub
BACKUP_REMOTE=
# Dossier contenant rclone.conf, monté en lecture seule dans le conteneur.
BACKUP_CONFIG_DIR=./backup-config
# Surveillance indépendante du worker, via POST HTTPS compatible ntfy.
OPERATIONS_ALERT_URL=
OPERATIONS_ALERT_TOKEN=
# true uniquement si le profil backups est démarré.
MONITOR_BACKUPS=false
# Token indépendant (32 caractères minimum) pour Uptime Kuma / surveillance externe.
OPERATIONS_HEALTH_TOKEN=
