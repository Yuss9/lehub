{
  "name": "lehub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "test:e2e": "node tests/run-e2e.mjs",
    "worker": "node --env-file-if-exists=.env --import tsx scripts/worker.ts",
    "account:recover": "node --env-file-if-exists=.env --import tsx scripts/recover-account.ts",
    "test:postgres": "node --import tsx scripts/test-postgres.ts",
    "backup:server": "node --env-file-if-exists=.env --import tsx scripts/server-backup.ts",
    "push:keys": "node --import tsx scripts/generate-vapid.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "adm-zip": "0.6.1",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.51.0",
    "next": "16.3.8",
    "next-themes": "0.4.6",
    "nodemailer": "10.0.15",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/adm-zip": "0.5.8",
    "@types/node": "26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "fake-indexeddb": "6.2.5",
    "smtp-server": "3.19.17",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
